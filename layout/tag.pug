extends includes/layout

block content
  .tags-page
    p.tags-desc 🏷️ 标签星云
    #tag-capsule-wrap

  script.
    const ICONS = ['🏷️','📌','🔖','🏅','🎯','⚡','📦','🎨','👁️','🛠️','💡','🔧'];
    fetch('/api/tags.json')
      .then(r => r.json())
      .then(data => {
        const max = Math.max(...data.map(t => t.length));
        const wrap = document.getElementById('tag-capsule-wrap');
        wrap.innerHTML = data.map((tag, i) => {
          const ratio = tag.length / max;
          const weight = ratio > 0.5 ? 'heavy' : ratio < 0.15 ? 'light' : '';
          return `<a class="tag-capsule ${weight}" href="/${tag.path}">
            <span class="tag-icon">${ICONS[i % ICONS.length]}</span>
            <span class="tag-name">${tag.name}</span>
            <span class="tag-sep">·</span>
            <span class="tag-count">${tag.length}</span>
          </a>`;
        }).join('');
      });
