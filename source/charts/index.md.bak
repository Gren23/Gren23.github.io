<style>
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; margin: 24px 0; }
.stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 20px; text-align: center; transition: transform 0.2s; }
.stat-card:hover { transform: translateY(-2px); }
.stat-icon { font-size: 32px; margin-bottom: 8px; }
.stat-num { font-size: 28px; font-weight: 700; color: var(--text-highlight); }
.stat-label { font-size: 13px; color: var(--text-color); opacity: 0.7; margin-top: 4px; }
</style>

<div class="stat-grid">
